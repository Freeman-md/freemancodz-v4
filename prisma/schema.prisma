generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteChunk {
  id         String @id
  sourceType String @map("source_type")
  sourceId   String @map("source_id")
  chunkIndex Int   @map("chunk_index")

  title    String
  category String
  url      String
  content  String
  keywords String[]

  embedding      Unsupported("vector(1536)")
  contentHash    String?                        @map("content_hash")
  embeddingModel String?                        @map("embedding_model")
  embeddedAt     DateTime?                      @map("embedded_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sourceType, sourceId, chunkIndex])
  @@map("site_chunks")
}

model SearchIndexJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operation   String
  sourceType  String    @map("source_type")
  sourceId    String    @map("source_id")
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([sourceType, sourceId])
  @@map("search_index_jobs")
}

model Meeting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleEventId      String   @unique @map("google_event_id")
  name               String
  email              String
  timezone           String
  reason             String
  startsAt           DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime @map("ends_at") @db.Timestamptz(6)
  status             String
  googleEventUrl     String?  @map("google_event_url")
  rawProviderPayload Json     @map("raw_provider_payload") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startsAt])
  @@map("meetings")
}

enum ContentPage {
  HOME  @map("home")
  ABOUT @map("about")

  @@map("content_page")
}

enum ContentSection {
  HERO                @map("hero")
  PHILOSOPHY          @map("philosophy")
  CURRENT_DIRECTION   @map("current_direction")
  ABOUT_HEADER        @map("about_header")
  ABOUT_INTRO         @map("about_intro")
  EDUCATION           @map("education")
  WORK_PROCESS        @map("work_process")
  OUTSIDE_ENGINEERING @map("outside_engineering")

  @@map("content_section")
}

model ContentBlock {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String         @unique
  page      ContentPage
  section   ContentSection
  position  Int            @default(0)
  content   Json           @db.JsonB
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([page, section, position])
  @@index([page, section, position])
  @@map("content_blocks")
}

model Principle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section   String
  title     String
  body      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([section, position])
  @@index([section, position])
  @@map("principles")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  lead            String
  description     String
  cta             String
  assistantPrompt String?  @map("assistant_prompt")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([position])
  @@map("services")
}

model Experience {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  company   String
  dates     String
  location  String?
  category  String
  focus     String
  position  Int      @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("experiences")
}

model Project {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String   @unique
  summary       String
  category      String
  role          String
  outcome       String
  detail        String
  future        String?
  collaboration String?
  positioning   String?
  featured      Boolean  @default(false)
  position      Int      @unique
  stacks        String[] @default([])
  links         Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([featured, position])
  @@map("projects")
}

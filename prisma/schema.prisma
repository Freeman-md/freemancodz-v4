generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteChunk {
  id        String                   @id
  title     String
  category  String
  url       String
  content   String
  keywords  String[]                 @default([])
  embedding Unsupported("vector")
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_chunks")
}

model Profile {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  headline                String
  intro                   String
  heroNote                String   @map("hero_note")
  philosophyQuestion      String   @map("philosophy_question")
  aboutHeadline           String   @map("about_headline")
  currentDirection        String   @map("current_direction")
  currentDirectionSupport String   @map("current_direction_support")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Education {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  current   String
  previous  String
  research  String
  support   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("educations")
}

model Principle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section   String
  title     String
  body      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([section, position])
  @@index([section, position])
  @@map("principles")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  lead            String
  description     String
  cta             String
  assistantPrompt String?  @map("assistant_prompt")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([position])
  @@map("services")
}

model ContentItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section   String
  title     String?
  body      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([section, position])
  @@index([section, position])
  @@map("content_items")
}

model Experience {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  company   String
  dates     String
  location  String?
  category  String
  focus     String
  position  Int      @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("experiences")
}

model Project {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String         @unique
  summary       String
  category      String
  role          String
  outcome       String
  detail        String
  future        String?
  collaboration String?
  positioning   String?
  featured      Boolean  @default(false)
  position      Int      @unique
  stacks        String[] @default([])
  links         Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([featured, position])
  @@map("projects")
}

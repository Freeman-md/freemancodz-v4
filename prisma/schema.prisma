generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Meeting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleEventId      String   @unique @map("google_event_id")
  name               String
  email              String
  timezone           String
  reason             String
  startsAt           DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime @map("ends_at") @db.Timestamptz(6)
  status             String
  googleEventUrl     String?  @map("google_event_url")
  rawProviderPayload Json     @map("raw_provider_payload") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startsAt])
  @@map("meetings")
}

model WorkflowInstance {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId         String          @map("workflow_id")
  workflowVersion    Int             @map("workflow_version")
  status             String          @default("active")
  state              Json            @db.JsonB
  revision           Int             @default(0)
  originChannel      String          @map("origin_channel")
  originPage         String?         @map("origin_page")
  originEntry        String?         @map("origin_entry")
  startedAt          DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  contactRequest     ContactRequest?

  @@map("workflow_instances")
}

model ContactRequest {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)
  name               String
  email              String
  message            String
  businessName       String?          @map("business_name")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_requests")
}

model RateLimit {
  scope     String
  keyHash   String   @map("key_hash")
  ruleId    String   @map("rule_id")
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scope, keyHash, ruleId])
  @@map("rate_limits")
}

enum ProjectKind {
  REAL_PROJECT @map("real-project")
  EXPLORATION  @map("exploration")

  @@map("portfolio_project_kind")
}

model Profile {
  key        String @id @default("global")
  name       String
  headline   String
  intro      String
  philosophy String

  @@map("portfolio_profiles")
}

model Project {
  slug         String           @id
  title        String
  summary      String
  kind         ProjectKind
  category     String
  company      String?
  cover        Json             @db.JsonB
  links        Json             @db.JsonB
  featured     Json?            @db.JsonB
  questions    String[]         @default([])
  displayOrder Int              @map("display_order")
  caseStudy    ProjectCaseStudy?
  serviceLinks ProjectService[]

  @@map("portfolio_projects")
}

model ProjectCaseStudy {
  projectSlug    String   @id @map("project_slug")
  project        Project  @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  role           String
  problem        String
  contribution   String
  outcome        String
  capabilities   String[]
  technologyKeys String[] @map("technology_keys")
  evidenceUrls   String[] @default([]) @map("evidence_urls")
  beforeUrl      String?  @map("before_url")
  afterUrl       String?  @map("after_url")
  serviceOffer   Json?    @map("service_offer") @db.JsonB

  @@map("portfolio_project_case_studies")
}

model Experience {
  key          String   @id
  name         String
  period       String
  role         String
  label        String
  details      String[]
  questions    String[] @default([])
  displayOrder Int      @map("display_order")

  @@map("portfolio_experiences")
}

model Service {
  key          String           @id
  title        String
  description  String
  requestDraft String           @map("request_draft")
  examples     String[]
  questions    String[]         @default([])
  displayOrder Int              @map("display_order")
  projectLinks ProjectService[]

  @@map("portfolio_services")
}

model ProjectService {
  projectSlug String  @map("project_slug")
  serviceKey  String  @map("service_key")
  position    Int
  project     Project @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  service     Service @relation(fields: [serviceKey], references: [key], onDelete: Restrict)

  @@id([projectSlug, serviceKey])
  @@unique([projectSlug, position])
  @@index([serviceKey])
  @@map("portfolio_project_services")
}

{
  "name": "freemancodz-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check . && eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:production": "dotenv -e .env.production.local -- prisma migrate deploy",
    "test:unit": "NODE_ENV=development node --conditions=react-server --import tsx --test tests/unit/assistant/*.test.ts tests/unit/portfolio/*.test.ts tests/unit/search-index/*.test.ts && NODE_ENV=development node --import tsx --test tests/unit/portfolio/public-static-exceptions.browser.ts",
    "test:integration": "NODE_ENV=development node --conditions=react-server --import tsx --test tests/integration/assistant/*.test.ts tests/integration/portfolio/*.test.ts",
    "test:portfolio:database": "NODE_ENV=development node --conditions=react-server --import tsx --test tests/integration/portfolio/portfolio-database.test.ts",
    "test:portfolio:admin": "NODE_ENV=development node --conditions=react-server --import tsx --test tests/unit/portfolio/admin-*.test.ts tests/unit/portfolio/cache-tags.test.ts tests/unit/portfolio/portfolio-administration.service.test.ts tests/unit/portfolio/portfolio-media-service.test.ts tests/unit/portfolio/presentation-adapters.test.ts && NODE_ENV=development node --import tsx --test tests/unit/portfolio/public-static-exceptions.browser.ts",
    "test": "npm run test:unit && npm run test:integration",
    "eval:assistant": "NODE_OPTIONS='--conditions=react-server' tsx tests/evals/assistant/assistant.eval.ts",
    "portfolio:bootstrap:local": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/maintenance/bootstrap-portfolio.ts",
    "portfolio:bootstrap:production": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.production.local src/server/entrypoints/maintenance/bootstrap-portfolio.ts --production",
    "admin-auth:provision:local": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/maintenance/provision-admin-auth-user.ts",
    "admin-auth:provision:production": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.production.local src/server/entrypoints/maintenance/provision-admin-auth-user.ts --production",
    "index:source": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/maintenance/index-source-record.ts",
    "index:worker": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/jobs/run-search-index-worker.ts",
    "index:worker:production": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.production.local src/server/entrypoints/jobs/run-search-index-worker.ts",
    "index:rebuild": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/maintenance/rebuild-search-index.ts",
    "index:rebuild:production": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.production.local src/server/entrypoints/maintenance/rebuild-search-index.ts --production",
    "index:status": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/cli/show-search-index-job-status.ts",
    "index:status:production": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.production.local src/server/entrypoints/cli/show-search-index-job-status.ts",
    "index:preview": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env src/server/entrypoints/cli/preview-search-index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "5.7.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.23.0",
    "markdown-to-jsx": "^9.9.0",
    "next": "^16.2.10",
    "openai": "^6.45.0",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.85.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.5.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "postcss": "8.5.16",
    "prettier": "3.9.6",
    "prisma": "^7.4.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}

{
  "name": "freemancodz-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:production": "dotenv -e .env.production.local -- prisma migrate deploy",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "test:rag-rpc": "tsx scripts/test-match-site-chunks.ts",
    "test:portfolio": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/portfolio/*.test.ts && tsx --test tests/portfolio/*.test.tsx",
    "test:search-indexing": "tsx --test tests/search-indexing/*.test.ts",
    "seed:portfolio": "tsx --env-file=.env scripts/seed-portfolio-data.ts",
    "seed:portfolio:production": "tsx --env-file=.env.production.local scripts/seed-portfolio-data.ts --production",
    "index:source": "tsx --env-file=.env scripts/index-source.ts",
    "index:worker": "tsx --env-file=.env scripts/index-worker.ts",
    "index:worker:production": "tsx --env-file=.env.production.local scripts/index-worker.ts",
    "index:rebuild": "tsx --env-file=.env scripts/rebuild-search-index.ts",
    "index:rebuild:production": "tsx --env-file=.env.production.local scripts/rebuild-search-index.ts --production",
    "index:status": "tsx --env-file=.env scripts/search-index-job-status.ts",
    "index:status:production": "tsx --env-file=.env.production.local scripts/search-index-job-status.ts",
    "index:preview": "tsx --env-file=.env scripts/preview-search-index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "openai": "^6.45.0",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.5.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.16",
    "prisma": "^7.4.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
